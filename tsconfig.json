{
  "extends": "@apify/tsconfig",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "noUnusedLocals": false,
    "lib": ["DOM"],
    "typeRoots": ["./node_modules/@types", "src/types"]
  },
  "include": ["./src/**/*"]
}
